{
  "name": "devcompass",
  "version": "4.1.8",
  "description": "CLI that checks npm dependencies for vulnerabilities, license risks, unused and outdated packages, with a CI gate.",
  "bin": {
    "devcompass": "bin/devcompass.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "data/",
    "schema/",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:coverage": "c8 --all --src src --include \"src/**\" --exclude \"src/dashboard/**\" --reporter=text --reporter=lcov --check-coverage --lines 40 node --test test/unit/*.test.js",
    "test:integration": "bash test/integration/test-complete-suite.sh",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dependencies",
    "npm",
    "security",
    "vulnerability-scanner",
    "cve",
    "osv",
    "license-checker",
    "unused-dependencies",
    "outdated",
    "supply-chain-security",
    "cli",
    "ci"
  ],
  "author": {
    "name": "Ajay Thorat",
    "email": "ajaythorat988@gmail.com",
    "url": "https://www.ajaythorat.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "4.1.2",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "knip": "^6.12.2",
    "open": "^11.0.0",
    "ora": "5.4.1",
    "p-limit": "^3.1.0",
    "semver": "^7.8.0",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjayBThorat-20/devcompass.git"
  },
  "bugs": {
    "url": "https://github.com/AjayBThorat-20/devcompass/issues"
  },
  "homepage": "https://devcompass.ajaythorat.com",
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
